{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rust Lab",
  "version": "1.0.6",
  "identifier": "ee.rustlab.app",
  "build": {
    "beforeDevCommand": "npm run css:watch",
    "beforeBuildCommand": "npm run css:build",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Rust Lab",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
